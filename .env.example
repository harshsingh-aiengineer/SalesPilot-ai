# Copy to .env and change the password and secret before daily use.
# Never commit .env, OAuth client secrets, or token files.

SALESPILOT_PASSWORD=change-me-now
SALESPILOT_SECRET=replace-with-a-long-random-string
SALESPILOT_ENV=development
SALESPILOT_DEV_MODE=false
SALESPILOT_AUTH_REQUIRED=true

DATABASE_URL=sqlite:////data/salespilot.db
DATA_DIR=/data

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=600
OLLAMA_TIMEOUT_SECONDS=120
MAX_CONCURRENT_LLM=1
MAX_AGENT_TOOL_CALLS=8
MAX_AGENT_SECONDS=180
MAX_HISTORY_MESSAGES=8

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_API_BASE=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/gmail/callback
GMAIL_TEST_RECIPIENT=

BUSINESS_TIMEZONE=Asia/Dubai
LOG_LEVEL=INFO

# Optional overrides. Defaults live under DATA_DIR/secrets/.
# GOOGLE_CLIENT_SECRETS_FILE=/data/secrets/google_client_secret.json
# GMAIL_TOKEN_FILE=/data/secrets/gmail_token.json
